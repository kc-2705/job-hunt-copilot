# Copy this file to .env and fill it in. Never commit .env.
PORT=8080
# MongoDB connection string (e.g. a free MongoDB Atlas cluster). Not needed for "npm run demo".
MONGO_URL=
# Any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Front-end address(es) allowed to call the API.
CLIENT_URL=http://localhost:5173

# Free API key from https://console.groq.com (no credit card needed).
GROQ_API_KEY=
# Optional: any OpenAI-compatible API and models (e.g. Ollama: http://localhost:11434/v1).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_FAST_MODEL=openai/gpt-oss-20b
# LLM_SMART_MODEL=openai/gpt-oss-120b
