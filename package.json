{
  "name": "job-hunt-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "AI job search assistant: match your resume to a job post with RAG, tailor bullets, draft cover letters and track applications.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "demo": "node scripts/demo.js",
    "client": "npm run dev --prefix client",
    "dev:all": "concurrently -n api,web -c cyan,magenta \"npm run demo\" \"npm run client\"",
    "build": "npm install --prefix client && npm run build --prefix client",
    "test": "node --test --test-concurrency=1 tests/"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "unpdf": "^1.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "expect": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
